# ThothMemory Mini: one owner, a few agents, thousands of small rows.
# Sized for the smallest practical footprint without weakening durability:
# every commit is fsynced, doublewrite stays on, crash recovery is normal.
[mariadbd]
# Local only: the service connects through a Unix socket inside the container.
skip-networking
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_bin
default-time-zone = '+00:00'
# Off: instrumentation, binary log, event scheduler, query cache.
performance_schema = OFF
skip-log-bin
event_scheduler = OFF
query_cache_type = 0
query_cache_size = 0
# The service pool holds at most 4 connections; owner tools need a few more.
max_connections = 10
thread_cache_size = 2
table_open_cache = 64
host_cache_size = 0
# InnoDB memory: the whole working set of a phone memory fits in 16 MiB.
innodb_buffer_pool_size = 16M
# MariaDB 11.x reserves address space for the largest the pool may ever grow to,
# 8 TiB by default. Android kernels with a 39-bit user address space (512 GiB)
# cannot map that, the failure ThothDock documents for MongoDB 8. Cap it far
# above any realistic need: resizing beyond 64M needs a restart, which is fine.
innodb_buffer_pool_size_max = 64M
innodb_log_file_size = 8M
innodb_log_buffer_size = 2M
innodb_buffer_pool_load_at_startup = OFF
innodb_buffer_pool_dump_at_shutdown = OFF
# PRoot and Android may deny native AIO; synchronous I/O is fine at this size.
innodb_use_native_aio = 0
innodb_read_io_threads = 1
innodb_write_io_threads = 2
innodb_purge_threads = 1
# Durability is not traded for benchmarks.
innodb_flush_log_at_trx_commit = 1
innodb_doublewrite = ON
innodb_flush_method = fsync
innodb_data_file_path = ibdata1:4M:autoextend
innodb_temp_data_file_path = ibtmp1:4M:autoextend
# Small per-connection and engine buffers (MyISAM/Aria hold system tables only).
key_buffer_size = 1M
aria_pagecache_buffer_size = 1M
tmp_table_size = 4M
max_heap_table_size = 4M
sort_buffer_size = 256K
join_buffer_size = 256K
read_buffer_size = 128K
read_rnd_buffer_size = 256K
wait_timeout = 600

[client]
default-character-set = utf8mb4
